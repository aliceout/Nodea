{
  "name": "@nodea/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx/esm src/index.ts",
    "start:docker": "node --import tsx/esm src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:migrate:docker": "tsx src/db/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.test src/db/migrate-test.ts",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "seed:test": "tsx --env-file-if-exists=../../.env src/seed/index.ts",
    "seed:all": "pnpm seed:admin && pnpm seed:test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "@nodea/shared": "workspace:*",
    "@sentry/node": "10.75.0",
    "@serenity-kit/opaque": "1.1.0",
    "@simplewebauthn/server": "14.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.8",
    "node-cron": "4.6.0",
    "nodemailer": "^10.0.10",
    "otplib": "13.5.0",
    "postgres": "^3.4.9",
    "puppeteer": "25.11.0",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
